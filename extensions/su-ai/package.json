{
  "name": "su-ai",
  "displayName": "Su AI",
  "description": "Built-in AI assistant for su (Chat, Ghost Text, Agent + Diff).",
  "version": "0.6.0",
  "publisher": "su",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "su.openChat",
        "title": "Su: 打开 Chat",
        "category": "Su",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "su.focusAgent",
        "title": "Su: 打开 Agent",
        "category": "Su",
        "icon": "$(robot)"
      },
      {
        "command": "su.stopGeneration",
        "title": "Su: 停止生成",
        "category": "Su",
        "icon": "$(debug-stop)"
      },
      {
        "command": "su.openSettings",
        "title": "Su: AI 配置（中转/模型）",
        "category": "Su",
        "icon": "$(gear)"
      },
      {
        "command": "su.editModels",
        "title": "Su: 编辑模型列表",
        "category": "Su",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "su.setApiKey",
        "title": "Su: 设置 API Key",
        "category": "Su",
        "icon": "$(key)"
      },
      {
        "command": "su.clearApiKey",
        "title": "Su: 清除 API Key",
        "category": "Su"
      },
      {
        "command": "su.checkForUpdates",
        "title": "Su: 检查更新",
        "category": "Su",
        "icon": "$(cloud-download)"
      },
      {
        "command": "su.openUserManual",
        "title": "用户手册",
        "category": "Su",
        "icon": "$(book)"
      },
      {
        "command": "su.toggleGhostText",
        "title": "Su: 切换 Ghost Text",
        "category": "Su",
        "icon": "$(sparkle)"
      },
      {
        "command": "su.reviewAgentDiffs",
        "title": "Su: 审阅 Agent 改动",
        "category": "Su",
        "icon": "$(diff)"
      },
      {
        "command": "su.keepAllAgentDiffs",
        "title": "Su: Keep 全部 Agent 改动",
        "category": "Su"
      },
      {
        "command": "su.rejectAllAgentDiffs",
        "title": "Su: Reject 全部 Agent 改动",
        "category": "Su"
      },
      {
        "command": "su.addToChat",
        "title": "添加到 Su Chat",
        "category": "Su",
        "icon": "$(add)"
      },
      {
        "command": "su.openAgentWindow",
        "title": "Su: 打开 Agent Window",
        "category": "Su",
        "icon": "$(window)"
      },
      {
        "command": "su.openIdeWindow",
        "title": "Su: 打开 IDE Window",
        "category": "Su",
        "icon": "$(files)"
      }
    ],
    "keybindings": [
      {
        "command": "su.openChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "!terminalFocus"
      },
      {
        "command": "su.focusAgent",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "!terminalFocus && !editorHoverFocused"
      },
      {
        "command": "su.stopGeneration",
        "key": "escape",
        "when": "su.chatStreaming"
      }
    ],
    "submenus": [
      {
        "id": "su.menubar",
        "label": "Su"
      }
    ],
    "menus": {
      "MenubarHelpMenu": [
        {
          "command": "su.openUserManual",
          "group": "1_welcome@50"
        },
        {
          "submenu": "su.menubar",
          "group": "4_su"
        }
      ],
      "MenubarPreferencesMenu": [
        {
          "command": "su.openSettings",
          "group": "4_su@1"
        },
        {
          "command": "su.editModels",
          "group": "4_su@2"
        },
        {
          "command": "su.setApiKey",
          "group": "4_su@3"
        }
      ],
      "su.menubar": [
        {
          "command": "su.openChat",
          "group": "1_chat@1"
        },
        {
          "command": "su.focusAgent",
          "group": "1_chat@2"
        },
        {
          "command": "su.openSettings",
          "group": "1_chat@3"
        },
        {
          "command": "su.editModels",
          "group": "1_chat@4"
        },
        {
          "command": "su.setApiKey",
          "group": "1_chat@5"
        },
        {
          "command": "su.toggleGhostText",
          "group": "1_chat@6"
        },
        {
          "command": "su.reviewAgentDiffs",
          "group": "1_chat@7"
        },
        {
          "command": "su.openAgentWindow",
          "group": "1_chat@8"
        },
        {
          "command": "su.openIdeWindow",
          "group": "1_chat@9"
        },
        {
          "command": "su.checkForUpdates",
          "group": "2_update@1"
        }
      ],
      "view/title": [
        {
          "command": "su.openAgentWindow",
          "when": "view == su.chat",
          "group": "navigation@0"
        },
        {
          "command": "su.reviewAgentDiffs",
          "when": "view == su.chat",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "su.addToChat",
          "group": "2_workspace@99",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "command": "su.addToChat",
          "group": "1_cutcopypaste@99",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "su.addToChat",
          "group": "navigation@99",
          "when": "resourceScheme == file"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "su-ai",
          "title": "Su AI",
          "icon": "media/su.svg"
        }
      ]
    },
    "views": {
      "su-ai": [
        {
          "type": "webview",
          "id": "su.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Su",
      "properties": {
        "su.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API base URL（中转 Base URL，需含 /v1）。"
        },
        "su.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "**已弃用。** 请用命令 `Su: 设置 API Key`（SecretStorage）。若仍有旧值，启动时会自动迁移并清空。"
        },
        "su.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "markdownDescription": "**默认模型**（仅填一个）。Chat 选 **Auto**、以及 Ghost Text 使用此 id。多个模型请配置下方的 `Su › Models`。"
        },
        "su.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "**额外模型列表（可多个）**。点「Add Item」逐个添加模型 id，与 Base URL / API Key 共用。也可命令面板运行 `Su: 编辑模型列表`。Chat 输入区可切换 Auto 或列表中任一模型。"
        },
        "su.timeoutMs": {
          "type": "number",
          "default": 60000,
          "description": "请求超时（毫秒）。"
        },
        "su.ghostText.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Ghost Text 行内补全（灰色预览，Tab 接受）。使用与 Chat 相同的中转 / Key，模型固定为 su.model（默认）。"
        },
        "su.ghostText.debounceMs": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "maximum": 5000,
          "description": "Ghost Text 请求防抖（毫秒）。"
        },
        "su.ghostText.maxTokens": {
          "type": "number",
          "default": 96,
          "minimum": 16,
          "maximum": 512,
          "description": "单次行内补全的 max_tokens。"
        },
        "su.ask.maxSteps": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 500,
          "description": "Ask 单轮最大只读工具（list_dir / read_file）步数。"
        },
        "su.agent.maxSteps": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10000,
          "description": "Agent 单轮最大工具调用步数。0 表示不限制（可用 Esc / 停止 中断）。"
        },
        "su.agent.enableTerminal": {
          "type": "boolean",
          "default": true,
          "description": "允许 Agent 使用 run_terminal（每次仍需确认）。"
        },
        "su.rules.enabled": {
          "type": "boolean",
          "default": true,
          "description": "将工作区 .su/rules/ 下 markdown 规则注入 Chat/Agent system 提示（无文件时静默跳过）。"
        },
        "su.update.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "启动后自动检查 GitHub Releases 是否有新版本并提示（可取消下载）。"
        },
        "su.update.repo": {
          "type": "string",
          "default": "wakaliu/su",
          "description": "用于检查更新的 GitHub 仓库（owner/name）。"
        },
        "su.update.includePrerelease": {
          "type": "boolean",
          "default": false,
          "description": "是否将 Pre-release 视为可更新版本。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.136.0",
    "typescript": "^5.7.2"
  }
}
